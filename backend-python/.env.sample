# Copy to .env on the SERVER. Never commit .env.
DT_TO_EMAIL=digitaltakhleeq@gmail.com
DT_SMTP_HOST=smtp.gmail.com
DT_SMTP_PORT=465
DT_SMTP_SECURE=ssl
DT_SMTP_USER=digitaltakhleeq@gmail.com
# Gmail App Password (2-Step Verification must be on). 16 characters.
DT_SMTP_PASS=
DT_FROM_EMAIL=digitaltakhleeq@gmail.com
DT_SITE_URL=https://digitaltakhleeq.com
DT_ALLOWED_HOSTS=digitaltakhleeq.com,www.digitaltakhleeq.com
DT_AUTOREPLY=true
DT_RATE_PER_HOUR=5
# Only set when behind a proxy you trust, e.g. CF-Connecting-IP
DT_TRUST_PROXY_HEADER=
# Folder for the lead backup log; keep it OUTSIDE any public folder.
DT_STORAGE_DIR=./storage

# Pricing file (defaults to ../assets/data/pricing.js, the same file the website reads)
# DT_PRICING_FILE=
